<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	Node's official nodejs.org builds ship signed with these same
	entitlements. The "Sign vendored binaries" build phase re-signs
	node with `codesign --force`, which strips whatever entitlements
	the binary already had -- without re-granting allow-jit here, V8
	traps (SIGTRAP/EXC_BREAKPOINT) the moment it tries to write-protect
	its JIT pages during startup, since Hardened Runtime blocks that
	syscall for unentitled processes.
	-->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
